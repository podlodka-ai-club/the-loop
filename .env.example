# Copy to .env and fill in. `.env` is git-ignored; never commit a real key.

# Required. Inference key for the OpenRouter OpenAI-compatible endpoint.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model under test.
GEOLOCATE_MODEL=google/gemma-4-31b-it

# Routing is pinned: one provider, one quantization, no fallbacks. OpenRouter serves
# the same slug from providers running fp4, fp8 and bf16 endpoints, and an unpinned
# run can land on a different one halfway through.
# Comma-separated, tried in order, nothing outside the list is allowed. Both of these
# serve bf16, so the second is a queue overflow rather than a different model.
OPENROUTER_PROVIDER=Novita,Venice
OPENROUTER_QUANTIZATION=bf16

# Decoding is pinned rather than sampled, so a repeat run is comparable item by item.
GEOLOCATE_TEMPERATURE=0
GEOLOCATE_SEED=1

# Fraction of image height cut from the bottom before the photo is sent. The bottom
# strip of some OSV-5M frames carries a burned-in coordinate overlay. Changing this
# changes the benchmark; 0.05 is the baseline value.
GEOLOCATE_CROP_BOTTOM=0.05

# Local OSV-5M copy: expects `test.csv` and `images/test/` below this directory.
OSV5M_DIR=tmp/datasets/osv5m

# Local Phoenix server. Start it with `uvx --from arize-phoenix phoenix serve` or the
# Docker image. Plain `uvx phoenix serve` installs an unrelated PyPI package named
# `phoenix` that ships no executable.
PHOENIX_BASE_URL=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT=geolocate

# Mem0 Cloud pilot. Use a new, never-reused agent id for each pilot run.
MEM0_API_KEY=
MEM0_AGENT_ID=
MEM0_INGESTION_TIMEOUT_MS=120000
MEM0_POLL_INTERVAL_MS=1000
MEM0_INTEGRATION=0

# xmemory Cloud. Test and pilot commands provision their own disposable instances.
XMEM_API_KEY=
# Required only when the application opens an existing runtime instance.
XMEM_INSTANCE_ID=

# Hindsight Cloud API key. Bank and memory_ref come from the resolved registry source.
HINDSIGHT_API_KEY=
