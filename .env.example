# Copy to .env and fill in. `.env` is git-ignored; never commit a real key.

# Required. Inference key for the Cerebras OpenAI-compatible endpoint.
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Model under test. The published baseline in docs/benchmark/osv5m-eval.md used this one.
GEOLOCATE_MODEL=gemma-4-31b

# Fraction of image height cut from the bottom before the photo is sent. The bottom
# strip of some OSV-5M frames carries a burned-in coordinate overlay. Changing this
# changes the benchmark; 0.05 is the baseline value.
GEOLOCATE_CROP_BOTTOM=0.05

# Local OSV-5M copy: expects `test.csv` and `images/test/` below this directory.
OSV5M_DIR=tmp/datasets/osv5m

# Local Phoenix server. Start it with `uvx phoenix serve` or the Docker image.
PHOENIX_BASE_URL=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT=geolocate
